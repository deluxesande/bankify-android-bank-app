<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.HomePage">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/user_image"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/baseline_account_circle_24"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="User Image" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/user_image"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/good_morning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textSize="14sp"
                        android:textColor="@android:color/darker_gray"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Morning"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:gravity="center" />


                </LinearLayout>

                <ImageView
                    android:id="@+id/bell_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/baseline_notifications_24"
                    android:background="@drawable/circle_border"
                    android:contentDescription="Notification Icon" />

            </RelativeLayout>

            <!-- Card Details Div -->
            <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/rounded_background"
                android:padding="16dp"
                android:layout_margin="16dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/balance_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balance"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true" />

                <TextView
                    android:id="@+id/balance_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$1,234.56"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_below="@id/balance_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/card_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1234 5678 9012 3456"
                    android:textSize="28sp"
                    android:textColor="@android:color/white"
                    android:layout_below="@id/balance_amount"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="25dp" />

                <TextView
                    android:id="@+id/valid_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valid"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_below="@id/card_number"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="15dp" />

                <TextView
                    android:id="@+id/valid_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/34"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:layout_below="@id/valid_title" />

                <TextView
                    android:id="@+id/cvv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVV"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_below="@id/card_number"
                    android:layout_toEndOf="@id/valid_date"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="15dp" />

                <TextView
                    android:id="@+id/cvv_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:layout_below="@id/cvv_title"
                    android:layout_toEndOf="@id/valid_date"
                    android:layout_marginStart="30dp"/>

            </RelativeLayout>
        </LinearLayout>

    </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bottomNavigationView"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bottom_background"
            android:elevation="2dp"
            app:menu="@menu/bottom_menu"
            app:itemIconSize="24dp"
            app:itemIconTint="@drawable/item_selector"
            app:itemRippleColor="@android:color/transparent"
            app:labelVisibilityMode="unlabeled" />


</RelativeLayout>